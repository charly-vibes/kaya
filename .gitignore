.pretender/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# espectacular generated state (regenerated by `ah`)
.espectacular/state/

# turu/whisper local notes
.whisper/
